  "emaillog": {"name": "email_log", "what": "one row per email", "status": "todo"},
  "alarm": {"name": "DLQ alarm", "what": "CloudWatch", "status": "todo"},
  "customers": {"name": "customers", "status": "done"},
  "orders": {"name": "orders", "status": "done"},
  "queued": {"name": "Queued"},
  "sending": {"name": "Sending"},
  "sent": {"name": "Sent"},
  "waiting": {"name": "Waiting to retry"},
  "gaveup": {"name": "Gave up", "what": "in the DLQ"},
  "hasEmail": {"name": "Has an email?"},
  "bounced": {"name": "Bounced before?"},
  "send": {"name": "Send it"},
  "skip": {"name": "Skip, log why"}
 }
