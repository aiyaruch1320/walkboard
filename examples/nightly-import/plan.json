{
  "title": "Nightly customer import to staging",
  "goal": "A CronJob reads new customers from BigQuery every night and sends them to the Customer API in batches",
  "lang": "en",
  "mode": "build",
  "settings": {
    "teachBack": true,
    "commit": "suggest"
  },
  "approved": true,
  "glossary": {
    "init": "init container: runs to completion before the main container starts",
    "Forbid": "If last night's run is still going, do not start another on top of it"
  },
  "steps": [
    {
      "id": "image",
      "title": "Build image + scan",
      "status": "done",
      "nodes": [
        "commit",
        "build"
      ],
      "detail": "Build the image from main and scan it for vulnerabilities",
      "done": "The image is in the registry and the scan passed",
      "confirmed": true
    },
    {
      "id": "trigger",
      "title": "CI updates the tag in the deploy repo",
      "status": "done",
      "nodes": [
        "build",
        "tagjob",
        "git"
      ],
      "detail": "CI changes the image tag in the deploy repo itself; nobody edits it by hand",
      "done": "An automatic commit appears in the deploy repo",
      "confirmed": true
    },
    {
      "id": "manifests",
      "title": "Manifests: CronJob + config + policy",
      "status": "doing",
      "nodes": [
        "git",
        "argo",
        "cm",
        "secret",
        "cronjob"
      ],
      "detail": "Write the CronJob, ConfigMap and NetworkPolicy manifests for ArgoCD to create in staging",
      "done": "ArgoCD synced; the CronJob exists, suspended"
    },
    {
      "id": "secrets",
      "title": "Add the BigQuery and API keys",
      "status": "todo",
      "nodes": [
        "secret",
        "wkey",
        "warehouse",
        "api"
      ],
      "detail": "Add the database password, API key and BigQuery key, and ask infra to open egress on :443",
      "done": "The CronJob reads every value and reaches BigQuery"
    },
    {
      "id": "run",
      "title": "Run once and check the result",
      "status": "todo",
      "nodes": [
        "cronjob",
        "warehouse",
        "db",
        "api"
      ],
      "detail": "Unsuspend, run once, and check every batch reached the API",
      "done": "Everything sent, the checkpoint saved, and a rerun sends nothing twice"
    }
  ],
  "views": [
    {
      "id": "flow",
      "kind": "flow",
      "title": "Deploy path",
      "lanes": [
        {
          "title": "CI",
          "nodes": [
            "commit",
            "build",
            "tagjob"
          ]
        },
        {
          "title": "GitOps",
          "nodes": [
            "git",
            "argo",
            "cronjob"
          ]
        }
      ]
    },
    {
      "id": "k8s",
      "kind": "map",
      "title": "Kubernetes",
      "zones": [
        {
          "label": "Outside the cluster",
          "stack": true,
          "nodes": [
            "git",
            "argo"
          ]
        },
        {
          "label": "cluster staging",
          "kind": "k8s:cluster",
          "zones": [
            {
              "label": "namespace imports",
              "kind": "k8s:namespace",
              "stack": true,
              "nodes": [
                "cm",
                "secret",
                "wkey"
              ],
              "zones": [
                {
                  "label": "NetworkPolicy",
                  "kind": "k8s:networkpolicy",
                  "props": {
                    "rules": "egress: DNS, PostgreSQL, Customer API, BigQuery"
                  },
                  "nodes": [
                    "cronjob"
                  ],
                  "note": "only the egress it needs"
                }
              ]
            }
          ]
        },
        {
          "label": "Reaches",
          "stack": true,
          "nodes": [
            "dns",
            "db",
            "api",
            "warehouse",
            "internet"
          ]
        }
      ],
      "links": [
        {
          "from": "git",
          "to": "argo",
          "kind": "k8s:uses"
        },
        {
          "from": "argo",
          "to": "cronjob",
          "label": "sync"
        },
        {
          "from": "cm",
          "to": "cronjob",
          "kind": "k8s:uses"
        },
        {
          "from": "secret",
          "to": "cronjob",
          "kind": "k8s:uses"
        },
        {
          "from": "wkey",
          "to": "cronjob",
          "kind": "k8s:mounts"
        },
        {
          "from": "cronjob",
          "to": "dns",
          "state": "ok",
          "label": ":53"
        },
        {
          "from": "cronjob",
          "to": "db",
          "state": "ok",
          "label": ":5432"
        },
        {
          "from": "cronjob",
          "to": "api",
          "state": "ok",
          "label": ":8080"
        },
        {
          "from": "cronjob",
          "to": "warehouse",
          "state": "todo",
          "label": ":443 waiting on infra"
        },
        {
          "from": "cronjob",
          "to": "internet",
          "state": "blocked"
        }
      ]
    },
    {
      "id": "run",
      "kind": "sequence",
      "title": "One nightly run",
      "actors": [
        "cronjob",
        "db",
        "warehouse",
        "api"
      ],
      "messages": [
        {
          "from": "cronjob",
          "to": "db",
          "text": "migrate schema (init container)",
          "step": "manifests"
        },
        {
          "from": "cronjob",
          "to": "db",
          "text": "read the last checkpoint",
          "step": "run"
        },
        {
          "from": "cronjob",
          "to": "warehouse",
          "text": "query customers after it",
          "step": "run"
        },
        {
          "from": "warehouse",
          "to": "cronjob",
          "text": "customer rows",
          "reply": true,
          "step": "run"
        },
        {
          "from": "cronjob",
          "to": "cronjob",
          "text": "split into batches of 200",
          "step": "run"
        },
        {
          "from": "cronjob",
          "to": "api",
          "text": "POST /customers:bulk",
          "step": "run"
        },
        {
          "from": "api",
          "to": "cronjob",
          "text": "result per item",
          "reply": true,
          "step": "run"
        },
        {
          "from": "cronjob",
          "to": "db",
          "text": "save the checkpoint",
          "node": "db",
          "step": "run"
        }
      ]
    },
    {
      "id": "data",
      "kind": "transform",
      "title": "How the data changes",
      "stages": [
        {
          "node": "warehouse",
          "label": "Rows from the query",
          "columns": [
            "CUSTOMER_NO",
            "JOINED",
            "SEGMENT"
          ],
          "rows": [
            [
              "0001042  ",
              "202305",
              "GOLD"
            ],
            [
              "0001043",
              "",
              null
            ]
          ],
          "notes": [
            "Every value is text",
            "CUSTOMER_NO has trailing spaces"
          ]
        },
        {
          "node": "cronjob",
          "label": "After checks and mapping",
          "columns": [
            "id",
            "joined_at",
            "segment",
            "result"
          ],
          "rows": [
            [
              "0001042",
              "2023-05-01",
              "gold",
              "send"
            ],
            [
              "0001043",
              "∅",
              "∅",
              "held: missing_joined"
            ]
          ],
          "notes": [
            "Trim trailing spaces, keep leading zeros",
            "YYYYMM → first day of the month",
            "Rows without a date are not sent; the problem is logged"
          ]
        },
        {
          "node": "api",
          "label": "Body sent (≤ 200 per batch)",
          "text": "{\n  \"items\": [\n    {\"id\": \"0001042\", \"joined_at\": \"2023-05-01\", \"segment\": \"gold\"}\n  ]\n}"
        }
      ]
    }
  ],
  "nodes": {
    "commit": {
      "name": "Commit on main",
      "status": "done",
      "in": "Reviewed code",
      "out": "The pipeline starts",
      "why": "main is always what staging runs"
    },
    "build": {
      "name": "Build + scan",
      "what": "one image",
      "status": "done",
      "file": ".gitlab-ci.yml",
      "in": "Code",
      "out": "registry/nightly-import:<sha>",
      "why": "No deploy unless the scan passes"
    },
    "tagjob": {
      "name": "Update tag",
      "what": "job in the deploy repo",
      "status": "done",
      "in": "IMAGE=…:<sha>",
      "out": "Edits image-patch.yaml and pushes",
      "why": "Nobody changes the tag by hand",
      "icon": "job"
    },
    "git": {
      "name": "Deploy repo",
      "what": "our team's Git",
      "status": "done",
      "file": "apps/nightly-import/overlays/staging",
      "in": "Commits from CI",
      "out": "Manifests ArgoCD reads",
      "why": "Everything in the cluster comes from Git"
    },
    "argo": {
      "name": "ArgoCD",
      "what": "manual sync",
      "status": "ext",
      "in": "overlays/staging",
      "out": "Creates and updates resources",
      "why": "Manual sync at first, so we can check before turning it on"
    },
    "cm": {
      "name": "ConfigMap",
      "what": "non-secret settings",
      "status": "new",
      "file": "base/configmap.yaml",
      "in": "DB_HOST, API_URL, BATCH_SIZE",
      "out": "Container environment",
      "why": "Change settings without rebuilding the image",
      "kind": "k8s:configmap"
    },
    "secret": {
      "name": "Secret",
      "what": "password + API key",
      "status": "todo",
      "file": "overlays/staging/secrets.yaml",
      "in": "The system owners",
      "out": "DB_PASSWORD, API_KEY",
      "why": "Real values never go into the repository",
      "kind": "k8s:secret"
    },
    "wkey": {
      "name": "BigQuery key",
      "what": "key.json (mounted)",
      "status": "todo",
      "in": "The data team",
      "out": "File at /etc/import/key.json",
      "why": "Only the import container uses it",
      "kind": "k8s:secret"
    },
    "cronjob": {
      "name": "CronJob import",
      "what": "nightly 02:00 · suspended",
      "status": "new",
      "file": "base/cronjob.yaml",
      "in": "Image, config, secret",
      "out": "A Job each night: migrate, then import",
      "why": "Forbid overlapping runs; stays suspended until the secrets exist",
      "kind": "k8s:cronjob",
      "props": {
        "schedule": "02:00",
        "suspended": "yes",
        "containers": "migrate (init), import"
      }
    },
    "dns": {
      "name": "DNS",
      "status": "ext",
      "in": "Host name",
      "out": "IP address"
    },
    "db": {
      "name": "PostgreSQL",
      "what": "job state",
      "status": "ext",
      "in": "Batches already sent",
      "out": "Where to resume after a failure",
      "why": "The next run continues where the last one stopped"
    },
    "api": {
      "name": "Customer API",
      "what": "destination",
      "status": "ext",
      "in": "POST /customers:bulk",
      "out": "Result per item",
      "why": "Sends 200 items at a time"
    },
    "warehouse": {
      "name": "BigQuery",
      "what": "source",
      "status": "ext",
      "in": "Query for new customers",
      "out": "Customer rows",
      "why": "Waiting for infra to open egress on :443",
      "kind": "gcp:bigquery"
    },
    "internet": {
      "name": "Everything else",
      "what": "the internet · blocked",
      "status": "ext",
      "why": "Blocked by the NetworkPolicy"
    }
  }
}
