 ],
 "options": [
  {"id": "peering", "title": "VPC Peering", "summary": "A direct 1:1 link between the two VPCs", "view": "v-peering", "recommended": true, "why": "Cheapest and simplest for two VPCs that both call each other; move to Transit Gateway past 3-4 VPCs"},
  {"id": "tgw", "title": "Transit Gateway", "summary": "A hub every VPC attaches to, shared across accounts with AWS RAM", "view": "v-tgw"},
  {"id": "privatelink", "title": "PrivateLink", "summary": "Account B publishes one service behind an NLB; account A calls it one way", "view": "v-pl"}
 ],
 "criteria": [
  {"id": "cost", "label": "Cost", "weight": 3},
